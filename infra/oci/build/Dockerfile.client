# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=docker.io/library/node:24.22.3-alpine3.24@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5
ARG NGINX_IMAGE=docker.io/library/nginx:1.30.4-alpine@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46

FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS build
ARG REACT_APP_RELEASE_VERSION
ARG SOURCE_DATE_EPOCH
ENV CI=true
ENV REACT_APP_RELEASE_VERSION=${REACT_APP_RELEASE_VERSION}
ENV REACT_APP_RELEASE_EPOCH=${SOURCE_DATE_EPOCH}
WORKDIR /app
COPY client/package.json client/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY client/ ./
RUN npm run build

FROM ${NGINX_IMAGE}
COPY client/nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chown=nginx:nginx /app/build /usr/share/nginx/html
USER nginx
RUN nginx -t
EXPOSE 3000
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
