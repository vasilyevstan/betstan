{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": false,
    "target": "ES2020"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/__test__/**",
    "src/**/*.test.ts",
    "src/test/**",
    "coverage",
    "dist",
    "node_modules"
  ]
}
