# Non-secret OCI identity and boundary
OCI_REGION=REQUIRED_HOME_REGION
OCI_CLI_VERSION=3.90.0
OCI_TENANCY_OCID=REQUIRED
OCI_CI_USER_OCID=REQUIRED
OCI_CI_KEY_FINGERPRINT=REQUIRED
OCI_COMPARTMENT_OCID=REQUIRED
OCI_COMPARTMENT_NAME=betstan-oci
OCI_AVAILABILITY_DOMAIN=REQUIRED

# Runtime selection: OKE remains available; k3s is the capacity-acquisition path.
OCI_RUNTIME_MODE=oke

# OKE and shared network
OCI_CLUSTER_NAME=betstan-oci
OCI_NODE_POOL_NAME=betstan-oci-a1
OCI_VCN_NAME=betstan-oci-vcn
OCI_K8S_NAMESPACE=betstan-oci
OCI_KUBERNETES_VERSION=REQUIRED
OCI_NODE_IMAGE_OCID=REQUIRED
OCI_NODE_SHAPE=VM.Standard.A1.Flex
OCI_VCN_CIDR=10.42.0.0/16
OCI_WORKER_SUBNET_CIDR=10.42.16.0/20
OCI_LB_SUBNET_CIDR=10.42.32.0/24
OCI_PODS_CIDR=10.244.0.0/16
OCI_SERVICES_CIDR=10.96.0.0/16
OCI_LB_NAME=betstan-oci-ingress
OCI_CANONICAL_HOST=betstan.xyz
OCI_REDIRECT_HOST=www.betstan.xyz

# Direct A1/k3s runtime
OCI_CAPACITY_QUOTA_NAME=betstan-free-tier-hard-limit
OCI_K3S_INSTANCE_NAME=betstan-k3s-node
OCI_K3S_IMAGE_OCID=REQUIRED_IF_K3S
OCI_K3S_VERSION=v1.34.9+k3s1
OCI_K3S_BINARY_SHA256=c782d6bb71eb2eb30f034aaddabb480294f9fdae5a7bca49ac5e3e0f66b96ea5
OCI_K3S_SSH_PUBLIC_KEY=REQUIRED_IF_K3S
OCI_K3S_NODE_NAME=betstan-k3s
OCI_BASTION_NAME=betstan-oke-bastion
OCI_BASTION_DEFAULT_CLIENT_CIDR=192.0.2.1/32
OCI_BASTION_MAX_SESSION_TTL=10800
OCI_A1_MEMORY_PROFILES=12
OCI_K3S_NODE_PORT_HTTP=30080
OCI_K3S_NODE_PORT_HTTPS=30443

# OCIR
OCI_REGISTRY_HOST=REQUIRED
OCI_REGISTRY_NAMESPACE=REQUIRED
OCI_IMAGE_PREFIX=betstan
OCI_REGISTRY_MAX_BYTES=500000000

# Immutable Always Free gates
OCI_A1_OCPUS=2
OCI_A1_MEMORY_GB=12
OCI_BOOT_VOLUME_GB=50
OCI_MONGO_VOLUME_GB=50
OCI_LB_MIN_MBPS=10
OCI_LB_MAX_MBPS=10
OCI_EXPECTED_MONTHLY_COST=0
OCI_MEMORY_MAX_PERCENT=70
OCI_DISK_MAX_PERCENT=70
OCI_CPU_MAX_PERCENT=90

# Pinned add-ons
OCI_INGRESS_NGINX_CHART_VERSION=4.15.1
OCI_INGRESS_NGINX_CHART_SHA256=3eff0bd18151d6e6b1c441463410571443dda1ac78292cb189346628de784f0c
OCI_CERT_MANAGER_CHART_VERSION=v1.21.1
OCI_CERT_MANAGER_CHART_SHA256=c27101f3f3e2349fb4a9e704316105bf7b52ad73b8c8257d3498ef7f2f6a4adc
OCI_CERT_MANAGER_CONTROLLER_DIGEST=sha256:416a2d76870d996460e62bd7f521bf14fa017be9e3e904aab92163a331fcb61a
OCI_CERT_MANAGER_WEBHOOK_DIGEST=sha256:d8b3961b51c8c7320633f8208dc46bf88aa13804d0f7cbe48a096b2c523cee42
OCI_CERT_MANAGER_CAINJECTOR_DIGEST=sha256:ccf6b919ec0500745a47a910118f834f9636d0aac1ff221245cd2557ed8c7c98
OCI_CERT_MANAGER_ACMESOLVER_DIGEST=sha256:dbc7cc1354f603918e7c5af7f55a0a620537394452c93a565bde75c6f48e8837
OCI_CERT_MANAGER_STARTUP_DIGEST=sha256:d8ab6416e6e7303a86fa0a8daa82c94a8001f21c9d78eb2e7db20534e5d07ae8

# Validation
OCI_HEALTH_MAX_ATTEMPTS=3
OCI_HEALTH_SLEEP_SECONDS=30
OCI_PUBLIC_URL=https://betstan.xyz
OCI_REDIRECT_URL=https://www.betstan.xyz
OCI_DIAGNOSTIC_URL=REQUIRED_AFTER_LOAD_BALANCER
OCI_CERT_EMAIL=REQUIRED
OCI_EXPECTED_HOME_MARKER=BetStan.xyz demo app

# Migration-only non-secret values
OCI_MIGRATION_AGE_RECIPIENT=REQUIRED
OCI_MIGRATION_AZURE_RESOURCE_GROUP=REQUIRED
OCI_MIGRATION_AZURE_CLUSTER_NAME=REQUIRED
AZURE_EXPECTED_CLUSTER_RESOURCE_ID_SHA256=REQUIRED
AZURE_EXPECTED_CLUSTER_SERVER_SHA256=REQUIRED

# Stop-only migration recovery values; keep scheduling inert by default.
OCI_MIGRATION_RECOVERY_ENABLED=false
OCI_MIGRATION_RECOVERY_ARM_UNTIL_EPOCH=0
OCI_MIGRATION_STALE_HEARTBEAT_SECONDS=3600
AZURE_MIGRATION_RECOVERY_RESOURCE_GROUP=REQUIRED
AZURE_MIGRATION_RECOVERY_CLUSTER_NAME=betstan-aks
AZURE_MIGRATION_RECOVERY_CLUSTER_RESOURCE_ID_SHA256=REQUIRED
AZURE_MIGRATION_RECOVERY_CLUSTER_SERVER_SHA256=REQUIRED

# Secrets are never stored in this file:
# OCI_CI_PRIVATE_KEY_PEM
# OCI_REGISTRY_USERNAME
# OCI_REGISTRY_AUTH_TOKEN
# OCI_JWT_KEY
# OCI_MIGRATION_AGE_IDENTITY
# OCI_MIGRATION_AZURE_CREDENTIALS
# AZURE_MIGRATION_RECOVERY_CREDENTIALS
